# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# Claude API key (https://console.anthropic.com/settings/keys). Used by
# teachers/anthropic_client.py for Phase 11 teacher-data generation.
ANTHROPIC_API_KEY=

# Which Claude model to use as a teacher. Defaults to the most capable
# model per Anthropic's own guidance -- bulk generation can get expensive
# at that tier, so lower this (e.g. claude-haiku-4-5) if cost matters more
# than quality for a given run.
CLAUDE_TEACHER_MODEL=claude-opus-5

# Hard cap on cumulative Anthropic API spend (USD), persisted+enforced by
# teachers/spend_tracker.py -- a call whose worst-case cost would exceed
# this is refused before it's ever sent (see data/anthropic_spend_log.json
# for the running total). Start low and raise deliberately once you know
# the real $/example cost for your prompts.
ANTHROPIC_BUDGET_USD=3.00

# Local Ollama server (no API key needed -- these models run on this
# machine). Only change this if Ollama is bound to a non-default host/port.
OLLAMA_HOST=http://localhost:11434

# Comma-separated list of Ollama model tags to cycle through for teacher
# data generation: pull -> generate -> delete -> next. Models already
# present locally are used as-is and are NOT deleted (see
# scripts/generate_teacher_data.py) -- only models this script pulls
# itself get cleaned up afterward.
OLLAMA_TEACHER_MODELS=gemma3:4b,qwen3.5:9b,llama3.2:latest,mistral:latest,deepseek-r1:8b,glm4:9b,command-r7b:latest
